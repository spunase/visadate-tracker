# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin API authentication (required in production)
ADMIN_API_KEY=your-admin-api-key

# Google OAuth (configured in Supabase dashboard or via `supabase config push`)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Resend SMTP for magic link emails (free: 100 emails/day)
RESEND_API_KEY=re_your-resend-api-key
SMTP_SENDER_EMAIL=noreply@yourdomain.com
